# Server-only. The browser bundle must not receive BACKEND_URL.
BACKEND_URL=http://backend:65524
FRONTEND_PORT=65525
BACKEND_PORT=65524

DATABASE_URL=sqlite+aiosqlite:////data/comppulse.db
# Production (the compose default) refuses to start unless:
#   APP_ENV=production, APP_SECRET is 32+ random characters, and HR_PASSWORD_HASH is set.
# Generate the hash with: python -m app.passwords <password>
# Single-quote the value in .env because it contains $:  HR_PASSWORD_HASH='scrypt$...'
# Local development: copy this file to .env and keep APP_ENV=development (plain HR_PASSWORD allowed).
APP_ENV=development
APP_SECRET=replace-with-a-long-random-string
HR_EMAIL=ss@interview.chetan
HR_PASSWORD=incubyte
# HR_PASSWORD_HASH=''
TOKEN_MAX_AGE_SECONDS=43200
SEED_COUNT=10000
